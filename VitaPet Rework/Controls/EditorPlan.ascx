<%@ Control Language="C#" AutoEventWireup="true" CodeBehind="EditorPlan.ascx.cs" Inherits="Controls_EditorPlan" %>
<%@ Register Src="~/Controls/ValidacionNumerica.ascx" TagPrefix="vp" TagName="ValidacionNumerica" %>
<asp:ValidationSummary ID="vsPlan" runat="server" CssClass="login-validation-summary" HeaderText="<%$ Resources:Textos, UI_RevisaLosSiguientesDatos %>" DisplayMode="BulletList" role="alert" />
<div class="empresa-campos">
 <div class="form-group login-field"><asp:Label runat="server" AssociatedControlID="txtNombrePlan" CssClass="login-label" Text="<%$ Resources:Textos, UI_Nombre %>" /><asp:TextBox ID="txtNombrePlan" runat="server" MaxLength="80" CssClass="form-control login-input" />
<asp:RequiredFieldValidator ID="rfvNombrePlan" runat="server" ControlToValidate="txtNombrePlan" ValidationGroup="" Display="Dynamic" CssClass="login-validation" ErrorMessage="<%$ Resources:Textos, Alta_Obligatorio %>" />
<asp:RegularExpressionValidator ID="revNombrePlan" runat="server" ControlToValidate="txtNombrePlan" ValidationGroup="" Display="Dynamic" CssClass="login-validation" ValidationExpression="^[^\x00-\x1F\x7F]{1,80}$" ErrorMessage="<%$ Resources:Textos, Alta_TextoInvalido %>" /></div>
 <%-- implementacion del componente ValidacionNumerica.ascx --%><vp:ValidacionNumerica ID="ucPrecio" runat="server" TextoEtiqueta="<%$ Resources:Textos, PlanAdmin_Precio %>" />
 <div class="form-group login-field"><asp:Label runat="server" AssociatedControlID="txtDescripcionPlan" CssClass="login-label" Text="<%$ Resources:Textos, PlanAdmin_Descripcion %>" /><asp:TextBox ID="txtDescripcionPlan" runat="server" TextMode="MultiLine" MaxLength="255" Rows="3" CssClass="form-control login-input" />
<asp:RequiredFieldValidator ID="rfvDescripcionPlan" runat="server" ControlToValidate="txtDescripcionPlan" ValidationGroup="" Display="Dynamic" CssClass="login-validation" ErrorMessage="<%$ Resources:Textos, Alta_Obligatorio %>" />
<asp:RegularExpressionValidator ID="revDescripcionPlan" runat="server" ControlToValidate="txtDescripcionPlan" ValidationGroup="" Display="Dynamic" CssClass="login-validation" ValidationExpression="^[\s\S]{1,255}$" ErrorMessage="<%$ Resources:Textos, Alta_TextoInvalido %>" /></div>
 <div class="form-group login-field"><asp:Label runat="server" AssociatedControlID="ddlEstadoPlan" CssClass="login-label" Text="<%$ Resources:Textos, Empresa_Estado %>" /><asp:DropDownList ID="ddlEstadoPlan" runat="server" CssClass="form-control login-input"><asp:ListItem Value="1" Text="<%$ Resources:Textos, Empresa_Activo %>" /><asp:ListItem Value="0" Text="<%$ Resources:Textos, Empresa_Inactivo %>" /></asp:DropDownList>
<asp:RegularExpressionValidator ID="revEstadoPlan" runat="server" ControlToValidate="ddlEstadoPlan" ValidationGroup="" Display="Dynamic" CssClass="login-validation" ValidationExpression="^[01]$" ErrorMessage="<%$ Resources:Textos, Alta_EstadoInvalido %>" /></div>
</div>
<h2 class="plan-admin-subtitulo"><%: TextosUI.Obtener("PlanAdmin_Coberturas") %></h2>
<div class="table-responsive plan-admin-tabla"><asp:GridView ID="gvCoberturas" runat="server" AutoGenerateColumns="false" DataKeyNames="idCobertura" CssClass="table plan-admin-editor" GridLines="None" OnRowCommand="FilaComando">
 <Columns>
  <asp:TemplateField HeaderText="<%$ Resources:Textos, PlanAdmin_Prestacion %>"><ItemTemplate><asp:TextBox ID="txtPrestacion" runat="server" Text='<%# Eval("prestacion") %>' MaxLength="100" CssClass="form-control login-input" aria-label="<%$ Resources:Textos, PlanAdmin_Prestacion %>" />
<asp:RequiredFieldValidator ID="rfvPrestacion" runat="server" ControlToValidate="txtPrestacion" ValidationGroup="" Display="Dynamic" CssClass="login-validation" ErrorMessage="<%$ Resources:Textos, Alta_Obligatorio %>" />
<asp:RegularExpressionValidator ID="revPrestacion" runat="server" ControlToValidate="txtPrestacion" ValidationGroup="" Display="Dynamic" CssClass="login-validation" ValidationExpression="^[^\x00-\x1F\x7F]{1,100}$" ErrorMessage="<%$ Resources:Textos, Alta_TextoInvalido %>" /></ItemTemplate></asp:TemplateField>
  <asp:TemplateField HeaderText="<%$ Resources:Textos, PlanAdmin_Detalle %>"><ItemTemplate><asp:TextBox ID="txtDetalle" runat="server" Text='<%# Eval("detalle") %>' MaxLength="255" TextMode="MultiLine" Rows="2" CssClass="form-control login-input" aria-label="<%$ Resources:Textos, PlanAdmin_Detalle %>" />
<asp:RequiredFieldValidator ID="rfvDetalle" runat="server" ControlToValidate="txtDetalle" ValidationGroup="" Display="Dynamic" CssClass="login-validation" ErrorMessage="<%$ Resources:Textos, Alta_Obligatorio %>" />
<asp:RegularExpressionValidator ID="revDetalle" runat="server" ControlToValidate="txtDetalle" ValidationGroup="" Display="Dynamic" CssClass="login-validation" ValidationExpression="^[\s\S]{1,255}$" ErrorMessage="<%$ Resources:Textos, Alta_TextoInvalido %>" /></ItemTemplate></asp:TemplateField>
  <asp:TemplateField HeaderText="<%$ Resources:Textos, Empresa_Estado %>"><ItemTemplate><asp:DropDownList ID="ddlEstadoCobertura" runat="server" SelectedValue='<%# Eval("estado") %>' CssClass="form-control login-input" aria-label="<%$ Resources:Textos, Empresa_Estado %>"><asp:ListItem Value="1" Text="<%$ Resources:Textos, Empresa_Activo %>" /><asp:ListItem Value="0" Text="<%$ Resources:Textos, Empresa_Inactivo %>" /></asp:DropDownList>
<asp:RegularExpressionValidator ID="revEstadoCobertura" runat="server" ControlToValidate="ddlEstadoCobertura" ValidationGroup="" Display="Dynamic" CssClass="login-validation" ValidationExpression="^[01]$" ErrorMessage="<%$ Resources:Textos, Alta_EstadoInvalido %>" /></ItemTemplate></asp:TemplateField>
  <asp:TemplateField><ItemTemplate><asp:LinkButton ID="lnkQuitarCoberturaNueva" runat="server" CommandName="QuitarNueva" CommandArgument='<%# Container.DataItemIndex %>' Visible='<%# (int)Eval("idCobertura")==0 %>' CausesValidation="false" CssClass="btn btn-default" Text="<%$ Resources:Textos, PlanAdmin_Quitar %>" /></ItemTemplate></asp:TemplateField>
 </Columns>
</asp:GridView></div>
<div class="plan-admin-agregar"><asp:Button ID="btnAgregarCobertura" runat="server" CausesValidation="false" CssClass="btn btn-default" OnClick="Agregar" Text="<%$ Resources:Textos, PlanAdmin_AgregarCobertura %>" /></div>

<asp:CustomValidator ID="cvDatosPlan" runat="server" ValidateEmptyText="true" EnableClientScript="false" OnServerValidate="ValidarDatos" Display="Dynamic" CssClass="login-validation" ErrorMessage="<%$ Resources:Textos, Alta_DatosInvalidos %>" />
