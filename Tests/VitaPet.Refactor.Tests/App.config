<configuration>
  <connectionStrings>
    <add name="VitaPetConnection" connectionString="Data Source=localhost;Initial Catalog=VitaPet_Verificacion_Refactor;Integrated Security=True;" />
  </connectionStrings>
  <appSettings>
    <add key="PagoProcesador" value="PruebaLocal" />
    <add key="RutaRecuperacion" value="runtime/recuperacion" />
    <add key="RutaBitacoraXml" value="runtime/Bitacora.xml" />
  </appSettings>
</configuration>
